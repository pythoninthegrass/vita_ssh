+#include <psp2/kernel/rng.h>
+    /*
+     * VitaSSHd: the Vita has no getentropy() and no /dev/urandom, so this is the
+     * only hardware entropy the device has. Two things the upstream patch got
+     * wrong, both of which decide whether a host key is worth anything.
+     *
+     * psp2/kernel/rng.h documents 'size' as 64 bytes maximum and the return as
+     * 0 on success, < 0 on error. A DRBG reseed asks for up to 2^14 bytes (see
+     * the note above), so one call is refused outright: the request has to be
+     * filled in chunks the kernel will accept.
+     *
+     * And the result has to be believed only when it says it worked. Returning
+     * buflen no matter what the syscall answered tells the DRBG it was handed
+     * buflen bytes of entropy when the buffer was never touched, which does not
+     * fail so much as quietly produce keys drawn from whatever the stack
+     * happened to hold -- a host key fingerprint nobody can trust, and the one
+     * failure this file must not allow. A chunk that fails ends the gather:
+     * what was actually obtained is returned, so the caller credits exactly the
+     * entropy the kernel really gave.
+     */
+    {
+        unsigned char *out = (unsigned char *)buf;
+        size_t done = 0;
+
+        while (done < buflen) {
+            size_t want = buflen - done < 64 ? buflen - done : 64;
+
+            if (sceKernelGetRandomNumber(out + done, (SceSize)want) != 0)
+                break;
+            done += want;
+        }
+        return done == 0 ? (ssize_t)-1 : (ssize_t)done;
+    }
