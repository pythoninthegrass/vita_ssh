diff --git a/src/misc.c b/src/misc.c
index f6f7410..e1e29c4 100644
--- a/src/misc.c
+++ b/src/misc.c
@@ -28,7 +28,9 @@
 /* This is needed for a standard getpwuid_r on opensolaris */
 #define _POSIX_PTHREAD_SEMANTICS
 #include <arpa/inet.h>
+#ifdef HAVE_NET_IF_H
 #include <net/if.h>
+#endif
 #include <netinet/in.h>
 #include <pwd.h>
 #include <sys/socket.h>
@@ -36,6 +38,20 @@
 
 #endif /* _WIN32 */
 
+#ifndef _WIN32
+#ifndef HAVE_NET_IF_H
+/* The Vita toolchain's newlib has no net/if.h. Link-local IPv6 scope ids in
+ * "addr%ifname" therefore cannot be resolved: return 0, which is the same
+ * "interface not found" result the callers below already handle by rejecting
+ * the address. */
+static unsigned int if_nametoindex(const char *ifname)
+{
+    (void)ifname;
+    return 0;
+}
+#endif
+#endif
+
 #include <errno.h>
 #include <fcntl.h>
 #include <limits.h>
diff --git a/src/socket.c b/src/socket.c
index 8065e5d..2bf41ee 100644
--- a/src/socket.c
+++ b/src/socket.c
@@ -42,13 +42,31 @@ struct sockaddr_un {
 #include <sys/types.h>
 #include <sys/wait.h>
 #include <sys/socket.h>
+#ifdef HAVE_SYS_UN_H
 #include <sys/un.h>
+#endif
 #include <signal.h>
 #ifdef HAVE_PTHREAD
 #include <pthread.h>
 #endif
 #endif /* _WIN32 */
 
+#ifndef HAVE_SYS_UN_H
+/* The Vita toolchain's newlib has no sys/un.h. The only users of AF_UNIX in
+ * this file are client-side helpers (ssh_socket_unix for the agent, and the
+ * socketpair() in the proxycommand/proxyjump paths) that a server never calls,
+ * so provide just enough for them to compile and fail at runtime. */
+#define AF_UNIX 1
+#define PF_UNIX AF_UNIX
+#ifndef UNIX_PATH_MAX
+#define UNIX_PATH_MAX 108
+#endif
+struct sockaddr_un {
+    sa_family_t sun_family;
+    char sun_path[UNIX_PATH_MAX];
+};
+#endif /* HAVE_SYS_UN_H */
+
 #include "libssh/priv.h"
 #include "libssh/callbacks.h"
 #include "libssh/socket.h"
