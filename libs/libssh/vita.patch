diff --git a/ConfigureChecks.cmake b/ConfigureChecks.cmake
index 4e32ea5..2550e40 100644
--- a/ConfigureChecks.cmake
+++ b/ConfigureChecks.cmake
@@ -65,6 +65,12 @@ check_include_file(byteswap.h HAVE_BYTESWAP_H)
 check_include_file(glob.h HAVE_GLOB_H)
 check_include_file(valgrind/valgrind.h HAVE_VALGRIND_VALGRIND_H)
 check_include_file(ifaddrs.h HAVE_IFADDRS_H)
+# Not upstream probes. The Vita toolchain's newlib ships neither header, and
+# libssh includes both unguarded on non-Windows (net/if.h in config.c and
+# misc.c, sys/un.h in socket.c), so without these the build dies before any of
+# the #ifdef guards below can help.
+check_include_file(net/if.h HAVE_NET_IF_H)
+check_include_file(sys/un.h HAVE_SYS_UN_H)
 
 if (WIN32)
   check_include_file(io.h HAVE_IO_H)
diff --git a/cmake/Modules/DefineCMakeDefaults.cmake b/cmake/Modules/DefineCMakeDefaults.cmake
index 6f369fa..087e83e 100644
--- a/cmake/Modules/DefineCMakeDefaults.cmake
+++ b/cmake/Modules/DefineCMakeDefaults.cmake
@@ -18,4 +18,7 @@ set(CMAKE_COLOR_MAKEFILE ON)
 set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
 
 # Always build with -fPIC
-set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+# Vita: vita-elf-create rejects GOT relocations (R_ARM_GOT_BREL). Honor the caller.
+if(NOT DEFINED CMAKE_POSITION_INDEPENDENT_CODE)
+  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+endif()
